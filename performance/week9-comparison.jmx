            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
 assert prev.getResponseCode() == "200"
 def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
 assert body.code == 0
 
} catch (Throwable ex) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage("HTTP/business assertion failed; response omitted to protect credentials") }</stringProp>
